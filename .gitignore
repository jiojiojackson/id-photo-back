# ==========================================
# 1. 过滤所有路径下的图片文件
# ==========================================
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tiff
*.ico
*.svg
*.heic
*.raw

# ==========================================
# 2. 过滤所有路径下的 AI / 模型文件
# ==========================================
*.onnx
*.pb
*.pth
*.pt
*.safetensors
*.bin
*.h5
*.tflite
*.ckpt
*.ptl
*.engine

# ==========================================
# 3. 过滤机密、密钥与环境变量文件
# ==========================================
# 环境变量与配置
.env
.env.*
!.env.example
!.env.template
config.json
secrets.yaml
secrets.json

# 私钥与证书
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.pub

# 密码与凭据文件
credentials.json
auth.json
*.pcap

# ==========================================
# 4. 过滤数据库与本地缓存/数据库文件
# ==========================================
*.sqlite
*.sqlite3
*.db
*.s3db

# ==========================================
# 5. 常见系统与编辑器垃圾文件
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs / 编辑器
.idea/
.vscode/
*.swp
*.swo
*~
